---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ServicesIT from '../components/ServicesIT.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
  <Hero lang={lang} />
  <Stats lang={lang} />

  <ServicesIT lang={lang} />

  <section id="operaciones" class="min-h-screen flex items-center justify-center px-4 bg-bg-light">
    <h2 class="font-display text-2xl text-text-muted">Operaciones IA — en construcción</h2>
  </section>

  <section id="proyectos" class="min-h-screen flex items-center justify-center px-4 bg-bg">
    <h2 class="font-display text-2xl text-text-muted">Proyectos — en construcción</h2>
  </section>

  <section id="sobre-mi" class="min-h-screen flex items-center justify-center px-4 bg-bg-light">
    <h2 class="font-display text-2xl text-text-muted">Sobre mí — en construcción</h2>
  </section>

  <section id="como-trabajo" class="min-h-screen flex items-center justify-center px-4 bg-bg">
    <h2 class="font-display text-2xl text-text-muted">Cómo trabajo — en construcción</h2>
  </section>

  <section id="contacto" class="min-h-screen flex items-center justify-center px-4 bg-bg-light">
    <h2 class="font-display text-2xl text-text-muted">Contacto — en construcción</h2>
  </section>
</Layout>

---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { key: 'stats.item1' },
  { key: 'stats.item2' },
  { key: 'stats.item3' },
] as const;
---

<section
  id="stats-band"
  data-stats-section
  class="bg-bg-dark py-16 md:py-20"
  aria-label={lang === 'es' ? 'Métricas de impacto' : 'Impact metrics'}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-6 text-center sm:text-left">
      {stats.map(({ key }) => (
        <div data-stat class="flex flex-col items-center sm:items-start gap-1">
          <span class="font-accent text-5xl md:text-6xl text-primary leading-none">
            {t(`${key}.value`)}
          </span>
          <span class="font-body text-sm text-white/60 leading-snug max-w-[180px]">
            {t(`${key}.label`)}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-stats-section]');

  if (section && 'IntersectionObserver' in window) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      // Show immediately without animation
      section.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
        el.classList.add('stat-visible');
      });
    } else {
      // Prepare for animated reveal
      section.classList.add('stats-animate');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const items = entry.target.querySelectorAll<HTMLElement>('[data-stat]');
              items.forEach((item, i) => {
                setTimeout(() => {
                  item.classList.add('stat-visible');
                }, i * 100);
              });
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      observer.observe(section);
    }
  }
</script>

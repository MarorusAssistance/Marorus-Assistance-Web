---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { number: t('stats.stat1.number'), label: t('stats.stat1.label') },
  { number: t('stats.stat2.number'), label: t('stats.stat2.label') },
  { number: t('stats.stat3.number'), label: t('stats.stat3.label') },
] as const;
---

<section
  id="stats-band"
  data-stats-section
  class="bg-bg-dark py-12 md:py-20"
  aria-label="Impacto en producción"
>
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      {stats.map(({ number, label }) => (
        <div data-stat class="flex flex-col">
          <span class="font-accent text-primary text-5xl md:text-6xl leading-none" aria-label={`${number}: ${label}`}>
            {number}
          </span>
          <div class="w-4 h-0.5 bg-primary mt-4 mb-4" aria-hidden="true"></div>
          <p class="font-body text-sm md:text-base text-[#9ca3af] max-w-[240px] leading-snug">
            {label}
          </p>
        </div>
      ))}
    </div>

    <p class="font-body text-xs text-[#6b7280] text-center mt-12 opacity-70">
      {t('stats.footnote')}
    </p>

  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-stats-section]');

  if (section && 'IntersectionObserver' in window) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      section.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
        el.classList.add('stat-visible');
      });
    } else {
      section.classList.add('stats-animate');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const items = entry.target.querySelectorAll<HTMLElement>('[data-stat]');
              items.forEach((item, i) => {
                setTimeout(() => item.classList.add('stat-visible'), i * 100);
              });
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      observer.observe(section);
    }
  }
</script>

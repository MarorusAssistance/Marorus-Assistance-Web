---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === 'es' ? '/' : '/en/';
const year = new Date().getFullYear();

const navLinks = [
  { key: 'nav.servicesIT', href: '#servicios-it' },
  { key: 'nav.operations', href: '#operaciones' },
  { key: 'nav.projects', href: '#proyectos' },
  { key: 'nav.about', href: '#sobre-mi' },
  { key: 'nav.howIWork', href: '#como-trabajo' },
  { key: 'nav.contact', href: '#contacto' },
];
---

<footer class="bg-bg-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Column 1: Logo + tagline -->
      <div>
        <a href={homeHref} class="font-display font-bold text-lg text-white hover:text-white/80 transition-colors">
          Maroru's Assistance
        </a>
        <p class="mt-3 text-sm text-white/50 leading-relaxed max-w-xs">
          {t('footer.tagline')}
        </p>
      </div>

      <!-- Column 2: Nav links -->
      <nav aria-label="Footer navigation">
        <ul class="space-y-3">
          {navLinks.map(({ key, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-white/50 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm"
              >
                {t(key)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 3: Social links -->
      <div>
        <ul class="space-y-3">
          <li>
            <a
              href="https://www.linkedin.com/in/manuel-pedro-romero-ruiz/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-sm text-white/50 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              {t('footer.links.linkedin')}
            </a>
          </li>
          <li>
            <a
              href="https://github.com/MarorusAssistance"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-sm text-white/50 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              {t('footer.links.github')}
            </a>
          </li>
          <!-- TODO: Add Malt URL when available -->
          <li>
            <a
              href="mailto:marorusassistance@gmail.com"
              class="flex items-center gap-2.5 text-sm text-white/50 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              {t('footer.links.email')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-10 pt-8 border-t border-white/10 text-xs text-white/30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <span>© {year} Maroru's Assistance. {t('footer.rights')}.</span>
    </div>
  </div>
</footer>

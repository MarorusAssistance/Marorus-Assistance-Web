---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const techStack = [
  'Azure',
  'Python',
  'LangChain',
  'LangGraph',
  'Azure OpenAI',
  'PostgreSQL',
  'FastAPI',
  'Docker',
];

const stackLabel = lang === 'es' ? 'Trabajo con' : 'I work with';
---

<section
  id="inicio"
  class="relative min-h-[calc(100vh-4rem)] md:min-h-[calc(100vh-5rem)] bg-bg flex items-center overflow-hidden"
>
  <!-- Mejora 1: dot pattern background -->
  <div class="absolute inset-0 hero-dots pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 w-full">

    <!-- Badge -->
    <div
      class="animate-fade-slide-down inline-flex items-center border border-border-soft rounded px-3 py-1 mb-8"
      aria-label="Tecnologías"
    >
      <span class="font-mono text-[10px] text-text-muted uppercase tracking-widest leading-none">
        {t('hero.badge')}
      </span>
    </div>

    <!-- H1 -->
    <h1
      class="animate-fade-slide-up font-display font-bold text-5xl md:text-6xl lg:text-7xl text-text leading-tight"
      style="animation-delay: 100ms;"
    >
      <span class="block">{t('hero.titleLine1')}</span>
      <span>{t('hero.titleLine2')} <span class="text-primary">{t('hero.titleAccent')}</span></span>
    </h1>

    <!-- Subtitle -->
    <p
      class="animate-fade-slide-up font-body text-lg md:text-xl text-text-muted max-w-[700px] leading-relaxed mt-8"
      style="animation-delay: 200ms;"
    >
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div
      class="animate-fade-slide-up flex flex-col sm:flex-row gap-4 mt-12"
      style="animation-delay: 300ms;"
    >
      <a
        href="#servicios-it"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-white font-medium rounded-md hover:bg-primary-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary w-full sm:w-auto"
      >
        {t('hero.ctaIT')} <span aria-hidden="true">→</span>
      </a>
      <a
        href="#operaciones"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-transparent text-text border border-text rounded-md hover:bg-text hover:text-bg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary w-full sm:w-auto"
      >
        {t('hero.ctaOps')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Mejora 2: tech stack row -->
    <div class="animate-fade-in mt-16 md:mt-20" style="animation-delay: 400ms;">
      <p class="font-mono text-xs text-text-muted uppercase tracking-widest mb-3">
        {stackLabel}
      </p>
      <div class="flex flex-wrap gap-2">
        {techStack.map((tech) => (
          <span class="font-mono text-xs px-3 py-1.5 border border-border-soft text-text-muted rounded hover:border-text-muted transition-colors">
            {tech}
          </span>
        ))}
      </div>
    </div>

  </div>

  <!-- Mejora 4: scroll indicator (solo desktop) -->
  <div class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 flex-col items-center gap-1.5 opacity-60">
    <button
      id="scroll-cue"
      type="button"
      aria-label="Scroll to next section"
      class="flex flex-col items-center gap-1.5 hover:opacity-100 transition-opacity focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded"
    >
      <div class="w-px h-8 bg-text-muted animate-scroll-bounce"></div>
      <svg xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
        <path d="M1 1L6 7L11 1" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>

<script>
  const scrollCue = document.getElementById('scroll-cue');
  if (scrollCue) {
    scrollCue.addEventListener('click', () => {
      document.getElementById('stats-band')?.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>

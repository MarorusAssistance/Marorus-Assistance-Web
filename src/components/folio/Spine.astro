---
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  esHref: string;
  enHref: string;
}

const { lang, esHref, enHref } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'es' ? '/' : '/en/';
const aboutHref = lang === 'es' ? '/sobre-mi' : '/en/about';

const links = [
  { label: t('folio.chapters.intro'), href: `${home}#quien` },
  { label: t('folio.chapters.work'), href: `${home}#casos` },
  { label: t('folio.chapters.services'), href: `${home}#servicios` },
  { label: t('folio.chapters.business'), href: `${home}#negocio` },
  { label: t('folio.chapters.record'), href: `${home}#trayectoria` },
  { label: t('folio.chapters.method'), href: `${home}#como-trabajo` },
  { label: t('folio.chapters.next'), href: `${home}#contacto` },
];
const year = new Date().getFullYear();
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-20 focus:z-[70] focus:bg-paper focus:px-4 focus:py-2">
  {t('folio.skip')}
</a>

<!-- Desktop spine -->
<aside class="hidden md:flex fixed inset-y-0 left-0 z-50 w-16 flex-col items-center bg-charcoal text-on-dark border-r border-rule-dark" aria-label="Maroru's Assistance">
  <button type="button" data-menu-open class="h-16 w-16 grid place-items-center border-b border-rule-dark cursor-pointer hover:text-primary-soft transition-colors" aria-label={t('folio.menu')} aria-expanded="false" aria-controls="folio-menu">
    <span class="block w-7 h-px bg-current shadow-[0_-6px_0_currentColor,0_6px_0_currentColor]" aria-hidden="true"></span>
  </button>
  <a href={home} class="mt-auto mb-auto font-display text-xl tracking-wide [writing-mode:vertical-rl] rotate-180 whitespace-nowrap">
    Maroru's Assistance
  </a>
  <span class="mb-6 text-[11px] text-on-dark-muted [writing-mode:vertical-rl] rotate-180 tabular">© {year}</span>
</aside>
<div class="hidden md:block fixed left-[62px] top-0 z-50 w-[2px] h-screen bg-primary origin-top scale-y-0" data-progress aria-hidden="true"></div>

<!-- Mobile bar -->
<header class="md:hidden fixed top-0 inset-x-0 z-50 h-14 flex items-center justify-between px-4 bg-charcoal text-on-dark border-b border-rule-dark">
  <a href={home} class="font-display text-2xl leading-none">Maroru's</a>
  <button type="button" data-menu-open class="h-10 w-10 grid place-items-center cursor-pointer" aria-label={t('folio.menu')} aria-expanded="false" aria-controls="folio-menu">
    <span class="block w-6 h-px bg-current shadow-[0_-5px_0_currentColor,0_5px_0_currentColor]" aria-hidden="true"></span>
  </button>
</header>

<!-- Full-screen menu -->
<div id="folio-menu" class="on-dark fixed inset-0 z-[60] bg-charcoal text-on-dark hidden" role="dialog" aria-modal="true" aria-label={t('folio.menu')}>
  <div class="h-full flex flex-col md:pl-16">
    <div class="flex items-center justify-between h-14 md:h-16 px-4 md:px-10 border-b border-rule-dark">
      <nav class="flex gap-3 text-sm" aria-label="Idioma / Language">
        <a href={esHref} data-lang-link="es" class:list={[lang === 'es' ? 'text-primary-soft' : 'text-on-dark-muted hover:text-on-dark']} aria-current={lang === 'es' ? 'true' : undefined}>Español</a>
        <a href={enHref} data-lang-link="en" class:list={[lang === 'en' ? 'text-primary-soft' : 'text-on-dark-muted hover:text-on-dark']} aria-current={lang === 'en' ? 'true' : undefined}>English</a>
      </nav>
      <button type="button" data-menu-close class="text-sm text-on-dark-muted hover:text-on-dark cursor-pointer px-2 py-2">{t('folio.close')}</button>
    </div>
    <nav class="flex-1 overflow-y-auto px-4 md:px-10 py-6 md:py-8" aria-label={t('folio.menu')}>
      <ol class="flex flex-col">
        {links.map(({ label, href }) => (
          <li class="border-b border-rule-dark">
            <a href={href} data-menu-link class="display block py-2.5 md:py-3 text-5xl md:text-[clamp(3rem,7.5vh,4.5rem)] hover:text-primary-soft transition-colors duration-300">{label}</a>
          </li>
        ))}
        <li class="border-b border-rule-dark">
          <a href={aboutHref} data-menu-link class="display block py-2.5 md:py-3 text-5xl md:text-[clamp(3rem,7.5vh,4.5rem)] hover:text-primary-soft transition-colors duration-300">{t('nav.about')}</a>
        </li>
      </ol>
    </nav>
    <div class="px-4 md:px-10 py-6 border-t border-rule-dark flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <a href={`${home}#contacto`} data-menu-link class="text-on-dark underline">{t('folio.cover.book')}</a>
      <a href="mailto:marorusassistance@gmail.com" class="text-on-dark-muted hover:text-on-dark">marorusassistance@gmail.com</a>
    </div>
  </div>
</div>


<script>
  const menu = document.getElementById('folio-menu');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  let lastOpener: HTMLButtonElement | null = null;

  const setOpen = (open: boolean) => {
    if (!menu) return;
    menu.classList.toggle('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    openers.forEach((b) => b.setAttribute('aria-expanded', String(open)));
    if (open) menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    else lastOpener?.focus();
  };

  openers.forEach((b) => b.addEventListener('click', () => { lastOpener = b; setOpen(true); }));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setOpen(false); });

  const langLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]');
  langLinks.forEach((el) => {
    el.addEventListener('click', () => {
      try { localStorage.setItem('marorus-lang', el.dataset.langLink ?? ''); } catch {}
    });
  });

  // One-time language auto-detect per session (kept from the previous switcher)
  try {
    if (!sessionStorage.getItem('marorus-lang-checked')) {
      sessionStorage.setItem('marorus-lang-checked', '1');
      const stored = localStorage.getItem('marorus-lang');
      const isEn = document.documentElement.lang === 'en';
      const preferEn = stored === 'en' || (!stored && navigator.language.startsWith('en'));
      const target = [...langLinks].find((a) => a.dataset.langLink === (preferEn ? 'en' : 'es'));
      if (target && ((preferEn && !isEn) || (!preferEn && stored === 'es' && isEn))) location.replace(target.href);
    }
  } catch {}

  // Reading progress along the spine
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleY(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

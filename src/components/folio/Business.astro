---
import Chapter from './Chapter.astro';
import { caseHref, opsCaseSlug } from '../../data/cases';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const blocks = (['block1', 'block2', 'block3', 'block4'] as const).map((key) => ({
  key,
  href: caseHref(opsCaseSlug[key], lang),
}));
---

<Chapter id="negocio" lang={lang} numeral="IV" name={t('folio.chapters.business')}>
  <div class="px-5 md:px-12 pt-16 md:pt-24 pb-24 md:pb-36 grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-12">
    <div class="lg:col-span-4 lg:sticky lg:top-10 self-start">
      <h2 id="negocio-title" class="display text-[clamp(3.2rem,6vw,6rem)]">{t('operations.title')}</h2>
      <p class="mt-6 text-lg text-ink-muted leading-relaxed">{t('operations.subtitle')}</p>
      <p class="mt-6 text-sm text-ink-muted leading-relaxed italic">{t('operations.transparencyNote')}</p>
    </div>

    <ol class="lg:col-span-7 lg:col-start-6 border-t border-rule">
      {blocks.map(({ key, href }) => (
        <li class="border-b border-rule py-8 md:py-10">
          <h3 class="text-2xl md:text-[2.1rem] leading-tight tracking-[-0.02em]">{t(`operations.${key}.title`)}</h3>
          <p class="mt-4 text-ink-muted leading-relaxed prose-measure">{t(`operations.${key}.pain.text`)}</p>
          <a href={href} class="inline-block mt-5 underline hover:text-primary transition-colors">{t('folio.business.seeCase')}</a>
        </li>
      ))}
    </ol>

    <div class="lg:col-span-7 lg:col-start-6 flex flex-col md:flex-row md:items-center gap-6 justify-between">
      <p class="text-ink-muted prose-measure">{t('operations.closingLine')}</p>
      <a href="#contacto" class="shrink-0 inline-flex items-center h-12 px-6 bg-ink text-paper hover:bg-primary transition-colors w-fit">{t('operations.cta')}</a>
    </div>
  </div>
</Chapter>

{
  "name": "marorus-assistance-web",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the contact API reaches the Worker; every other request is a static file
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "MAIL_FROM": "web@marorusassistance.com",
    "MAIL_TO": "marorusassistance@gmail.com"
  },
  // Sends only to the owner's verified Email Routing address
  "send_email": [
    { "name": "EMAIL", "destination_address": "marorusassistance@gmail.com" }
  ],
  // TURNSTILE_SECRET is a Worker secret (wrangler secret put), never in this file
  // Contact form: at most 5 submissions per minute per IP (per Cloudflare location)
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}

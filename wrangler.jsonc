{
  "name": "marorus-assistance-web",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the contact API reaches the Worker; every other request is a static file
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "MAIL_FROM": "web@marorusassistance.com",
    "MAIL_TO": "marorusassistance@gmail.com"
  },
  // Sends only to the owner's verified Email Routing address
  "send_email": [
    { "name": "EMAIL", "destination_address": "marorusassistance@gmail.com" }
  ],
  "queues": {
    "producers": [{ "binding": "CONTACT_QUEUE", "queue": "contact-messages" }],
    "consumers": [
      {
        "queue": "contact-messages",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "contact-messages-dlq"
      },
      { "queue": "contact-messages-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  // Durable trace of failed / poison messages (key failed:<id>, kept 90 days)
  "kv_namespaces": [
    { "binding": "CONTACT_FAILED", "id": "ed63dbd77ee6416fbc91adb44a80bb97" }
  ]
}
